generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Accounts & cloud sync ───────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cloudData    CloudData?
}

/// One encrypted-at-source JSON snapshot of the user's whole ledger
/// (DirhamWise "Backup" shape — accounts, txns, budgets, goals, …).
model CloudData {
  userId    String   @id
  blob      String
  size      Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Daily AED→INR snapshots, shared by all users — powers the sparkline
/// and the "change vs yesterday" badge.
model RateSnapshot {
  id        String   @id @default(cuid())
  day       String   @unique // YYYY-MM-DD
  rate      Float // INR per 1 AED
  source    String   @default("er-api")
  fetchedAt DateTime @default(now())
}
